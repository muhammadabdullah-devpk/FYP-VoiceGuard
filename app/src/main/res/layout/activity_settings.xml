<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_settings"
                android:textColor="@color/primary"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Detection -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/set_detection" />

        <TextView
            android:id="@+id/tvThresholdValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_dark"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/seekThreshold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="90"
            android:min="30" />

        <TextView
            style="@style/SettingHelp"
            android:text="@string/set_threshold_help" />

        <TextView
            style="@style/SettingLabel"
            android:text="@string/set_window_label" />

        <RadioGroup
            android:id="@+id/radioWindow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbWin2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/set_win_2" />

            <RadioButton
                android:id="@+id/rbWin3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/set_win_3" />

            <RadioButton
                android:id="@+id/rbWin4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/set_win_4" />
        </RadioGroup>

        <TextView
            style="@style/SettingLabel"
            android:text="@string/set_source_label" />

        <RadioGroup
            android:id="@+id/radioSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbSrcMic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/set_src_mic" />

            <RadioButton
                android:id="@+id/rbSrcVoiceRec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/set_src_voice_rec" />

            <RadioButton
                android:id="@+id/rbSrcUnprocessed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/set_src_unprocessed" />
        </RadioGroup>

        <TextView
            style="@style/SettingHelp"
            android:text="@string/set_source_help" />

        <!-- Alerts -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/set_alerts" />

        <TextView
            style="@style/SettingLabel"
            android:text="@string/set_family_label" />

        <EditText
            android:id="@+id/etFamilyReminder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:textSize="14sp" />

        <TextView
            style="@style/SettingHelp"
            android:text="@string/set_family_help" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchVibrate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_vibrate" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_overlay" />

        <TextView
            android:id="@+id/tvOverlayHelp"
            style="@style/SettingHelp"
            android:text="@string/set_overlay_help" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTestAlert"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/set_test_alert" />

        <!-- Keywords -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/set_keywords" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchKeywords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_keywords_enable" />

        <TextView
            android:id="@+id/tvKeywordModelInfo"
            style="@style/SettingHelp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnManageKeywords"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/set_manage_keywords" />

        <!-- Model and benchmark -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/set_model" />

        <TextView
            android:id="@+id/tvModelInfo"
            style="@style/SettingHelp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBenchmark"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/set_benchmark" />

        <TextView
            android:id="@+id/tvBenchmarkResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_dark"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
